{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "fintechbankx-service values",
  "type": "object",
  "required": [
    "serviceName",
    "serviceId",
    "boundedContext",
    "image",
    "service",
    "resources",
    "externalSecret",
    "networkPolicy",
    "istio"
  ],
  "properties": {
    "serviceName": {
      "type": "string",
      "description": "Workload and ServiceAccount name, e.g. loan-lifecycle-service",
      "pattern": "^[a-z][a-z0-9-]{1,61}[a-z0-9]$"
    },
    "serviceId": {
      "type": "string",
      "description": "Service id per the naming standard, e.g. svc-ln-loan-lifecycle",
      "pattern": "^svc-[a-z]+-[a-z0-9-]+$"
    },
    "boundedContext": {
      "type": "string",
      "description": "Bounded context, e.g. lending, payments, customer, risk, compliance, open-finance",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "owningSquad": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "",
        "dev",
        "staging",
        "prod"
      ]
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "not": {
            "pattern": "^(?i:latest)$"
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent"
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "tag": {
              "minLength": 1
            }
          },
          "required": [
            "tag"
          ]
        },
        {
          "properties": {
            "digest": {
              "minLength": 1
            }
          },
          "required": [
            "digest"
          ]
        }
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 2
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "roleArn": {
          "type": "string",
          "pattern": "^(|arn:aws[a-z-]*:iam::[0-9]{12}:role/.+)$"
        },
        "annotations": {
          "type": "object"
        },
        "automountToken": {
          "type": "boolean"
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "port",
        "managementPort"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "managementPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ]
        },
        "limits": {
          "type": "object",
          "required": [
            "memory"
          ]
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 2
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 2
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 10,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 10,
          "maximum": 100
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "topologySpread": {
      "type": "object",
      "properties": {
        "maxSkew": {
          "type": "integer",
          "minimum": 1
        },
        "zoneWhenUnsatisfiable": {
          "enum": [
            "DoNotSchedule",
            "ScheduleAnyway"
          ]
        },
        "hostWhenUnsatisfiable": {
          "enum": [
            "DoNotSchedule",
            "ScheduleAnyway"
          ]
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "externalSecret": {
      "type": "object",
      "required": [
        "enabled",
        "secretStoreRef"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiVersion": {
          "enum": [
            "external-secrets.io/v1beta1",
            "external-secrets.io/v1"
          ]
        },
        "secretStoreRef": {
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "enum": [
                "ClusterSecretStore",
                "SecretStore"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "remoteSecretName": {
          "type": "string",
          "description": "This service's own secret. Must start with <environment>/<serviceName>/ (prefix enforced at template time); empty only when externalSecret is disabled.",
          "pattern": "^(|(dev|staging|prod)/[a-z][a-z0-9-]{1,61}[a-z0-9]/[A-Za-z0-9/_+=.@-]+)$"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "secretKey",
              "property"
            ]
          }
        },
        "extraData": {
          "type": "array",
          "description": "Additional keys from this service's own secrets. remoteSecretName must start with <environment>/<serviceName>/ (enforced at template time).",
          "items": {
            "type": "object",
            "required": [
              "secretKey",
              "remoteSecretName",
              "property"
            ],
            "properties": {
              "secretKey": {
                "type": "string",
                "minLength": 1
              },
              "remoteSecretName": {
                "type": "string",
                "pattern": "^(dev|staging|prod)/[a-z][a-z0-9-]{1,61}[a-z0-9]/[A-Za-z0-9/_+=.@-]+$"
              },
              "property": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "monitoringNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "egressNamespaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "ports"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 1
              }
            }
          }
        },
        "egressCidrs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cidr",
              "ports"
            ],
            "properties": {
              "cidr": {
                "type": "string",
                "description": "A narrowed range (VPC or VPC endpoint subnets): an IPv4 CIDR with a prefix of /8 to /32 or an IPv6 CIDR with a prefix of /32 to /128. Wider ranges are rejected, including any-address ranges split into halves (0.0.0.0/1 + 128.0.0.0/1). The template additionally rejects public IPv4 ranges wider than /16 (outside RFC1918 and 100.64.0.0/10) and IPv6 ranges overlapping the IPv4-mapped block ::ffff:0:0/96 or the NAT64 prefixes 64:ff9b::/96 and 64:ff9b:1::/48.",
                "minLength": 1,
                "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}/(?:[89]|[12][0-9]|3[0-2])|[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]*/(?:3[2-9]|[4-9][0-9]|1[01][0-9]|12[0-8]))$"
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 1
              }
            }
          }
        }
      }
    },
    "istio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inject": {
          "const": true
        },
        "holdApplicationUntilProxyStarts": {
          "type": "boolean"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "not": {
        "required": [
          "traffic.sidecar.istio.io/excludeInboundPorts"
        ]
      }
    },
    "databaseCa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "configMapName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.pem$"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._/-]+$"
        }
      }
    }
  }
}
