// SECONDARY TEMPLATE. GitHub Actions (.github/workflows/java-service-ci.yml and
// friends) is the primary, reviewed CI path for FinTechBankX. This Jenkins
// equivalent mirrors its gates: gradle check (jacoco gate), the controller
// Map<String,Object> guardrail, OpenAPI lint and gitleaks.
pipeline {
  agent any

  tools {
    jdk 'jdk23'
  }

  options {
    disableConcurrentBuilds()
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Quality Gates') {
      steps {
        sh 'chmod +x templates/ci/scripts/resolve-gradle-command.sh'
        sh '''
          set -euo pipefail
          GRADLE_CMD="$(bash templates/ci/scripts/resolve-gradle-command.sh)"
          ${GRADLE_CMD} --no-daemon clean check
          controllers="$(git ls-files '*Controller.java' | grep 'src/main/java/' || true)"
          if [ -n "$controllers" ] && grep -nE 'Map<\\s*String\\s*,\\s*Object\\s*>' $controllers; then
            echo 'Generic Map<String,Object> payloads are disallowed in controllers.'
            exit 1
          fi
        '''
      }
    }

    stage('OpenAPI Lint') {
      when {
        expression { fileExists('api/openapi') }
      }
      steps {
        sh '''
          set -euo pipefail
          if ls api/openapi/*.yaml >/dev/null 2>&1; then
            npx -y @redocly/cli@1.27.1 lint api/openapi/*.yaml
          fi
        '''
      }
    }

    stage('Secret Scan') {
      steps {
        sh '''
          set -euo pipefail
          if command -v gitleaks >/dev/null 2>&1; then
            gitleaks detect --source . --no-git --redact --no-banner
          else
            echo "gitleaks is not installed on this Jenkins agent."
            exit 1
          fi
        '''
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: '**/build/reports/**', allowEmptyArchive: true
      junit testResults: '**/build/test-results/**/*.xml', allowEmptyResults: true
    }
  }
}
