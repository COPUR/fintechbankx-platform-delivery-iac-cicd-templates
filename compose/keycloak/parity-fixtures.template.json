          "type": "password",
          "value": "$(env:PARITY_PASSWORD_COMPLIANCE_OFFICER)",
          "temporary": false
        }
      ]
    },
    {
      "username": "parity-auditor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Parity",
      "lastName": "Auditor",
      "email": "parity-auditor@parity.invalid",
      "realmRoles": [
        "auditor"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "$(env:PARITY_PASSWORD_AUDITOR)",
