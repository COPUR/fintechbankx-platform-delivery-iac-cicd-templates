  "clients": [
    {
      "clientId": "parity-suite",
      "name": "Regression parity suite (ephemeral only)",
      "description": "Confidential client of the monolith-vs-services parity suite. Ephemeral/local compose fixture only; never part of the identity repo's realm. Password grant is enabled here and nowhere else.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:PARITY_SECRET_PARITY_SUITE)",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "fbx.client-type": "parity-test",
        "access.token.lifespan": "300",
        "use.refresh.tokens": "false",
        "client_credentials.use_refresh_token": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-svc-ln-loan-lifecycle",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "svc-ln-loan-lifecycle",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "aud-svc-pay-initiation-settlement",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "svc-pay-initiation-settlement",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "aud-svc-cus-profile-kyc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "svc-cus-profile-kyc",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "aud-svc-rsk-decisioning",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "svc-rsk-decisioning",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "aud-svc-cmp-evidence",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "svc-cmp-evidence",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email",
        "customer-id"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "parity-tpp",
      "name": "Regression parity TPP (ephemeral only)",
      "description": "Open-finance TPP actor of the parity suite: private_key_jwt (PS256) client authentication, DPoP-bound access tokens, client credentials only. Ephemeral/local compose fixture only; its key pair is generated per environment and never committed.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "fbx.client-type": "open-finance-tpp",
        "fbx.tpp.token-binding": "dpop",
        "dpop.bound.access.tokens": "true",
        "use.jwks.url": "false",
        "use.jwks.string": "true",
        "token.endpoint.auth.signing.alg": "PS256",
        "access.token.signed.response.alg": "PS256",
        "access.token.lifespan": "300",
        "use.refresh.tokens": "false",
        "client_credentials.use_refresh_token": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      }
    }
  ]
}
